# Public URL of the deployed site (used for canonical URLs, sitemap, OG tags).
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL automatically.
NEXT_PUBLIC_SITE_URL=https://www.crunchtheory.store

# Google Analytics 4 Measurement ID. Vercel production builds default to G-T0HTG7NX71
# (see src/lib/env.ts). Set it here to test tracking locally, or set it empty to disable.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-T0HTG7NX71

# Google Search Console HTML-tag verification token (optional).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional: deliver contact/newsletter submissions by email through Resend (https://resend.com).
# Without these, submissions are written to the server log (visible in Vercel → Logs).
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional sender. Leave EMPTY unless the domain is verified in Resend (Domains → Add). When empty,
# Resend's test sender is used, which can only deliver to the Resend account's own email —
# so CONTACT_TO_EMAIL must be the address you signed up to Resend with.
CONTACT_FROM_EMAIL=
